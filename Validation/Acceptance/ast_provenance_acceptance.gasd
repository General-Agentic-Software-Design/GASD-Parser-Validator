VERSION 1.2
CONTEXT: "AST provenance acceptance validation"
TARGET: "Python3"
NAMESPACE: "validation.ast_provenance.acceptance"
TRACE: "AT-AST-PROVENANCE-014-01", "AT-AST-PROVENANCE-014-02", "AT-AST-PROVENANCE-014-04", "AT-AST-PROVENANCE-015-01", "AT-AST-PROVENANCE-015-03", "AT-AST-PROVENANCE-017-01", "AT-AST-PROVENANCE-017-02"

FLOW verify_ast_provenance_acceptance():
    1. ACHIEVE "Export an entry, one CRLF import, and leave an unrelated file nearby" @trace(#AT-AST-PROVENANCE-014-01) AS PROVENANCE_ACCEPTANCE_1
        POSTCONDITION: "The sorted inventory has the two AST source paths and their independently hashed raw bytes."
    2. ACHIEVE "Edit the entry and the resolved dependency in separate successful runs" @trace(#AT-AST-PROVENANCE-014-02) AS PROVENANCE_ACCEPTANCE_2
        POSTCONDITION: "The edited path has its new SHA-512 and unchanged source digests match their previous values."
    3. ACHIEVE "Export one standalone entry and then two entries sharing a transitive import chain" @trace(#AT-AST-PROVENANCE-014-04) AS PROVENANCE_ACCEPTANCE_3
        POSTCONDITION: "The standalone inventory contains its entry and the combined inventory contains each contributing logical path exactly once."
    4. ACHIEVE "Export to stdout and a file for each supported GASD version and capture each JSON report" @trace(#AT-AST-PROVENANCE-015-01) AS PROVENANCE_ACCEPTANCE_4
        POSTCONDITION: "Both hexadecimal digests and content rules version 1 are nested under report semantic_validate, including for a GASD 1.1 AST with no validation marker. Independently hashing the actual destination bytes reproduces the byte digest."
    5. ACHIEVE "Hand off the original semantic AST bytes to two downstream file consumers" @trace(#AT-AST-PROVENANCE-015-03) AS PROVENANCE_ACCEPTANCE_5
        POSTCONDITION: "The consumers receive byte-identical copies and each copy reproduces the reported SHA-512."
    6. ACHIEVE "Compute the canonical UTF-8 JSON independently for a known model" @trace(#AT-AST-PROVENANCE-017-01) AS PROVENANCE_ACCEPTANCE_6
        POSTCONDITION: "The versioned projection retains authored values, stable links and ordered semantics and excludes source and export metadata. Its SHA-512 matches the content fingerprint."
    7. ACHIEVE "Edit the type of a resolved field and re-export" @trace(#AT-AST-PROVENANCE-017-02) AS PROVENANCE_ACCEPTANCE_7
        POSTCONDITION: "Both report fingerprints change and each matches its own defined input."
