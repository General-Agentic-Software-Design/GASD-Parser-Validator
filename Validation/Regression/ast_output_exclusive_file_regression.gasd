VERSION 1.2
/*
   Validation: Exclusive File Output Regression Tests
   ===================================================
   Ensures that existing --ast-output and --ast-sem workflows continue to function correctly.
*/

NAMESPACE: "GASD-Validator.Validation.Regression"
CONTEXT: "Regression Verification of Exclusive File Output"
TARGET: "GASD Agent", "Python3"
TRACE: "US-PARSER-013"

FLOW test_regression_ast_combine_with_ast_output():
    @trace("RT-PARSER-013-01") AS TRACE_TEST_REGRESSION_AST_COMBINE_WITH_AST_OUTPUT
    1. ACHIEVE "Export two files with --ast-combine --json, with and without --ast-output"
        POSTCONDITION: "Both commands complete and AST documents are captured"
    2. ENSURE "Both AST documents contain one SemanticSystem with nodes from both files"
        OTHERWISE THROW "Regression Failure: --ast-combine with --ast-output did not produce aggregated output"
    3. ENSURE "The explicit file destination leaves stdout empty"
        OTHERWISE THROW "Regression Failure: AST JSON leaked to stdout with --ast-combine and --ast-output"

FLOW test_regression_no_validate_with_ast_output():
    @trace("RT-PARSER-013-02") AS TRACE_TEST_REGRESSION_NO_VALIDATE_WITH_AST_OUTPUT
    1. ACHIEVE "Export a GASD file with --json --no-validate, with and without --ast-output"
        POSTCONDITION: "Both commands complete and AST documents are captured"
    2. ENSURE "Both destinations receive the same syntactic AST bytes"
        OTHERWISE THROW "Regression Failure: Syntax-only AST differs by destination"

FLOW test_regression_default_stdout_unchanged():
    @trace("RT-PARSER-013-03") AS TRACE_TEST_REGRESSION_DEFAULT_STDOUT_UNCHANGED
    1. ACHIEVE "Send the same specification to stdin with --json and with --json --ast-output"
        POSTCONDITION: "Both AST documents and streams are captured"
    2. ENSURE "Both documents describe the same AST and preserve the stdin source identifier"
        OTHERWISE THROW "Regression Failure: Stdin export differs by destination"
