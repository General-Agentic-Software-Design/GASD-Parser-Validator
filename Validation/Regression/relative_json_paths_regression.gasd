VERSION 1.2
NAMESPACE: "gasd.validation.regression.json"
CONTEXT: "Regression Validation for JSON Paths"
TARGET: "Python3"
TRACE: "#US-PARSER-010", "#RT-PARSER-010-01", "#RT-PARSER-010-02"

INVARIANT LOCAL: "Legacy JSON standard output must align with Semantic AST relativization"

DECISION "Regression Scenarios":
    CHOSEN: "Validate legacy paths output"
    RATIONALE: "Ensures regressions don't leak absolute paths."
    ALTERNATIVES: ["No legacy tests"]
    AFFECTS: [RegressionValidation]

COMPONENT RegressionValidation:
    INTERFACE:
        test_legacy_json_output() -> Boolean

FLOW test_legacy_json_output() -> Boolean:
    1. ACHIEVE "Ensure standard JSON output without --ast-sem adopts relative paths" @trace #RT-PARSER-010-01
        POSTCONDITION: "result == true"
    2. ACHIEVE "Ensure absolute paths provided as CLI args are correctly relativized in final AST" @trace #RT-PARSER-010-02
        POSTCONDITION: "result == true"
    3. RETURN true
