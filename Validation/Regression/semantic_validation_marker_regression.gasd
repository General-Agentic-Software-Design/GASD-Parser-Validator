VERSION 1.2
/*
   Validation: Semantic Validation Marker — Regression & Compatibility
   ==================================================================
   Ensures that the new validation marker feature (US-PARSER-008) does 
   not negatively impact legacy (v1.1) processing or existing JSON consumers.
*/

NAMESPACE: "GASD-Validator.Validation.Regression"
CONTEXT: "Regression Verification for US-PARSER-008"
TARGET: "GASD Agent"
TRACE: "US-PARSER-008"

// See Design/semantic_validation_marker_design.gasd for the marker structure.

FLOW validate_marker_regression():
    1. ACHIEVE "Run gasd_parser on a VERSION 1.1 file with --json":
        POSTCONDITION: "The run produces a verified AST and a JSON report"
    2. ENSURE "The AST and report both carry a PASSED semantic_validate marker with gasd_file_version 1.1"
        OTHERWISE THROW "The version 1.1 export is missing its validation result"
        @trace(#AC-PARSER-008-01) AS REG_MARKER_LEGACY_TRACE

    3. ACHIEVE "Run gasd_parser on a VERSION 1.2 file with --json --no-validate":
        POSTCONDITION: "The run produces a syntactic AST and a JSON report"
    4. ENSURE "The syntactic AST omits the validation marker and the report omits any successful AST fingerprint"
        OTHERWISE THROW "The syntax-only export unexpectedly certified a semantic AST"
        @trace(#AC-PARSER-008-01) AS REG_MARKER_VISIBILITY_TRACE

    5. ENSURE "JSON readers can read the validated AST and report with the semantic_validate field"
        OTHERWISE THROW "Existing JSON readers could not read the report"
        @trace(#AC-PARSER-008-01) AS REG_READER_COMPAT_TRACE
