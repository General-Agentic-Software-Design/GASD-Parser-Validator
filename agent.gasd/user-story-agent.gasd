VERSION 1.2
/*
   Run flows with the path to the selected requirements document.

   Pass user_stories_file as the second argument to keep stories in a separate Markdown file.
*/
CONTEXT: "User story creation, coverage audit, and specification hardening"
TARGET: "User Story Agent"
TRACE: "agent.gasd/user-story-agent.gasd"
NAMESPACE: "agent.template.user_story"

CONSTRAINT: "Each flow MUST read input_file as its source of requirements and any existing acceptance criteria. Resolve relative paths from the project root or, outside a project, the working directory. The input MUST be an existing readable requirements document."
CONSTRAINT: "Use user_stories_file as the Markdown story destination when supplied. If it is omitted or null, use input_file for Markdown input and a sibling file named after the input stem with the suffix -user-stories.md for other formats. Preserve the source requirements text and keep edits within the resolved story destination."
CONSTRAINT: "Creation may create a separate story Markdown file. Audit and hardening require an existing readable Markdown file with user stories. Report the affected path and make no edits if a required input or destination is invalid."
CONSTRAINT: "Keep stories within the selected requirements scope and use the terminology of the project or domain. Consult relevant specifications, policies, or supporting material when the requirements refer to them. Record unresolved decisions or ambiguities that affect the stories."
CONSTRAINT: "Reuse applicable epics and existing stories. Preserve trace identifiers and follow the destination's established ID conventions. Use US-NNN, AC-NNN-NN, AT-NNN-NN, and RT-NNN-NN for new identifiers when no convention exists. Link each acceptance criterion to its source requirement ID or section and retain any applicable source test references."
CONSTRAINT: "State the actor, capability, and intended benefit for each story. Make acceptance criteria verifiable through relevant preconditions, actions, and observable outcomes. Cover failure and boundary cases supported by the source requirements."
CONSTRAINT: "When the stories concern existing behavior, consult available implementation, tests, or other evidence. Cite evidence for current behavior, mark uncertain status as unverified, and carry forward any required existing behavior."
CONSTRAINT: "After completing the requested story work, wait for the next human instruction."

FLOW create_user_stories(input_file: String, user_stories_file: Optional<String>):
    1. ENSURE "input_file is a readable requirements document"
        OTHERWISE THROW RequirementsFileError
    2. ENSURE "The resolved story destination is a writable Markdown file or a valid Markdown creation target"
        OTHERWISE THROW UserStoriesFileError
    3. ACHIEVE "Read input_file, any existing stories in the resolved story destination, and relevant evidence for the selected requirements":
        POSTCONDITION: result.requirements_and_existing_stories_loaded == true
    4. ACHIEVE "Derive user stories and necessary sub-tasks from the selected requirements, reusing applicable epics and existing stories":
        POSTCONDITION: result.user_story_structure_complete == true
    5. ENSURE "Each scoped requirement has story coverage, testable acceptance criteria, and source traceability"
        OTHERWISE THROW RequirementCompletenessError
    6. ACHIEVE "Write the story sections to the resolved story destination":
        POSTCONDITION: result.user_stories_written == true
    7. ACHIEVE "Wait for the next human instruction":
        POSTCONDITION: result.paused_for_human_instruction == true

FLOW audit_user_story_coverage(input_file: String, user_stories_file: Optional<String>):
    1. ENSURE "input_file is a readable requirements document"
        OTHERWISE THROW RequirementsFileError
    2. ENSURE "The resolved story destination is a readable and writable Markdown file with existing user stories"
        OTHERWISE THROW UserStoriesFileError
    3. ACHIEVE "Compare the requirements and acceptance criteria in input_file with the stories and supporting evidence":
        POSTCONDITION: result.requirements_coverage_comparison_complete == true
    4. ACHIEVE "Resolve coverage gaps in the selected requirements scope with traceable stories and testable acceptance criteria":
        POSTCONDITION: result.coverage_gaps_resolved == true
    5. ENSURE "The stories cover the selected requirements and their acceptance criteria"
        OTHERWISE THROW RequirementCoverageGapError
    6. ACHIEVE "Write any story edits to the resolved story destination":
        POSTCONDITION: result.story_coverage_updates_complete == true
    7. ACHIEVE "Wait for the next human instruction":
        POSTCONDITION: result.paused_for_human_instruction == true

FLOW harden_user_story_spec(input_file: String, user_stories_file: Optional<String>):
    1. ENSURE "input_file is a readable requirements document"
        OTHERWISE THROW RequirementsFileError
    2. ENSURE "The resolved story destination is a readable and writable Markdown file with existing user stories"
        OTHERWISE THROW UserStoriesFileError
    3. ACHIEVE "Read input_file, identify the stories that cover its requirements, and review relevant evidence":
        POSTCONDITION: result.requirements_and_scoped_stories_loaded == true
    4. ACHIEVE "Make the actor, capability, reason, and source trace explicit for each scoped story":
        POSTCONDITION: result.story_contracts_complete == true
    5. ACHIEVE "Clarify the scope, artifact ownership, and required output of each applicable sub-task":
        POSTCONDITION: result.subtask_scope_and_artifacts_explicit == true
    6. ACHIEVE "Make each acceptance criterion testable with clear conditions and observable outcomes appropriate to the story":
        POSTCONDITION: result.acceptance_criteria_testable == true
    7. ACHIEVE "Cover relevant failure, boundary, and quality requirements supported by the selected source":
        POSTCONDITION: result.required_cases_covered == true
    8. ENSURE "The hardened stories cover the selected requirements and provide enough detail for delivery and validation"
        OTHERWISE THROW RequirementCoverageGapError
    9. ENSURE "The hardened acceptance criteria have valid source and story traces"
        OTHERWISE THROW RequirementTraceabilityError
    10. ACHIEVE "Write the hardened story sections to the resolved story destination":
        POSTCONDITION: result.hardened_stories_written == true
    11. ACHIEVE "Wait for the next human instruction":
        POSTCONDITION: result.paused_for_human_instruction == true
