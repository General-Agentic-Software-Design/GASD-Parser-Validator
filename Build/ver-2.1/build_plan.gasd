/*
   --- Build Plan: GASD Parser-Validator v2.0 ---
   Build plan for GASD Parser-Validator v2.0 (GASD 1.2 support).
   Phases cover Design, Validation, Testing, Implementation, Quality, and Packaging.
*/

VERSION: "1.2"
NAMESPACE: "GASD-Parser-Validator-v2.0"

CONTEXT: "Compiler / Language Tooling"
TARGET: "ANTLR4", "Python3"
TRACE: "US-V2-001", "US-V2-002", "US-V2-003", "US-V2-004", "US-V2-005", "US-V2-006", "US-V2-007", "US-V2-008", "US-V2-009", "US-PARSER-008", "US-PARSER-009", "US-PARSER-010", "US-PARSER-011", "US-PARSER-012", "US-PARSER-013"
TRACE: "GEP-7", "AT-GEP7-001", "AT-GEP7-002", "AT-GEP7-003", "AT-GEP7-004", "RT-GEP7-001", "RT-GEP7-002", "NT-GEP7-001", "NT-GEP7-002", "NT-GEP7-003"

TRACE: "AST-US-001", "AST-US-002", "AST-US-003", "AST-AT-001", "AST-AT-002", "AST-AT-003"

CONSTRAINT: "GASD agent MUST only execute one phase and pause by default, unless explicitly instructed by a human."
CONSTRAINT: "GASD agent MUST read and master 'GASD/GASD-1.2/GASD_Specification.md' and 'GASD/GASD-1.1/GASD_Specification-1.1.md' before generating any GASD files."
CONSTRAINT: "GASD agent MUST read and master 'Requirements/ver-2.x/ver-2.0/User_story.md' before executing any phase."

// ===================================================================

// PHASE 1 — Design (Output: Design/ folder)
// Generate design-level GASD specifications for each component.
// ===================================================================

FLOW phase1_generate_design():
    1. ACHIEVE "Read Requirements/ver-2.x/ver-2.0/User_story.md", "Requirements/ver-2.x/ver-2.1/CLI Optimization and Flag Consolidation.md", "Requirements/ver-2.x/ver-2.1/semantic_pass.md", "Requirements/ver-2.x/ver-2.1/gasd_file_version.md", "Requirements/ver-2.x/ver-2.1/relative_source_map_paths.md", "Requirements/ver-2.x/ver-2.1/cli_default_info_output.md", "Requirements/ver-2.x/ver-2.1/enforce_invariant_order.md", "Requirements/ver-2.x/ver-2.1/ast_output_exclusive_file.md" and "Requirements/ver-2.x/ver-2.1/GEP-7: GASD 1.2 Contract Validation and Case Guards.md"
        POSTCONDITION: "Requirements IDs extracted from all documents"
        POSTCONDITION: "Source capture, occurrence verification, and artifact publication requirements are traced from Requirements/ver-2.x/ver-2.1/GASD_Parser_AST_Requirements.md"
    2. ENSURE "All #US-V2, #AC-V2, #AT-V2, #RT-V2, #US-PARSER-007, #AC-PARSER-007, #AT-PARSER-007, #RT-PARSER-007, #US-PARSER-008, #AC-PARSER-008, #AT-PARSER-008, #RT-PARSER-008, #US-PARSER-009, #AC-PARSER-009, #AT-PARSER-009, #RT-PARSER-009, #US-PARSER-010, #AC-PARSER-010, #AT-PARSER-010, #RT-PARSER-010, #US-PARSER-011, #AC-PARSER-011, #AT-PARSER-011, #RT-PARSER-011, #US-PARSER-012, #AC-PARSER-012, #AT-PARSER-012, #RT-PARSER-012, #US-PARSER-013, #AC-PARSER-013, #AT-PARSER-013, #RT-PARSER-013 IDs are extracted"
        OTHERWISE THROW "Requirements Traceability Failed"
    3. ACHIEVE "Generate Design/component_design.gasd" @trace #US-V2-001, #US-PARSER-007
        POSTCONDITION: "Design/component_design.gasd exists and incorporates flag consolidation logic"
    4. ENSURE "All AC-V2, AC-PARSER-007, AC-PARSER-008, AC-PARSER-009, AC-PARSER-010, AC-PARSER-011, AC-PARSER-012 and AC-PARSER-013 IDs are traced in design files"
        OTHERWISE THROW "Design Traceability Failed"
    ### Design: Semantic Validation Marker (US-PARSER-008)
    5. ACHIEVE "Generate Design/semantic_validation_marker_design.gasd" @trace #US-PARSER-008
        POSTCONDITION: "Design/semantic_validation_marker_design.gasd exists and defines ValidationMarker structure"
    ### Design: GASD File Version in Semantic AST (US-PARSER-009)
    6. ACHIEVE "Generate Design/gasd_file_version_design.gasd" @trace #US-PARSER-009
        POSTCONDITION: "Design/gasd_file_version_design.gasd exists and defines GasdFileVersion extraction, semantic_validate.gasd_file_version injection, metadata.version injection, and equality constraints"
    ### Design: Universal Relative JSON Paths (US-PARSER-010)
    7. ACHIEVE "Generate Design/relative_json_paths_design.gasd" @trace #US-PARSER-010
        POSTCONDITION: "Design/relative_json_paths_design.gasd exists and defines relativization logic for generated JSON output"
    ### Design: CLI Default Info Output (US-PARSER-011)
    8. ACHIEVE "Generate Design/cli_default_info_output_design.gasd" @trace #US-PARSER-011
        POSTCONDITION: "Design/cli_default_info_output_design.gasd exists and defines default output info format"
    ### Design: Enforce INVARIANT Scope Ordering (US-PARSER-012)
    9. ACHIEVE "Generate Design/enforce_invariant_order_design.gasd" @trace #US-PARSER-012
        POSTCONDITION: "Design/enforce_invariant_order_design.gasd exists and defines mandatory INVARIANT <SCOPE> ordering"
    ### Design: AST JSON destination parity (US-PARSER-013)
    10. ACHIEVE "Specify AST routing and source reconciliation in Design/ast_output_exclusive_file_design.gasd and Design/cpc_semantic_ast_design.gasd" @trace(#US-PARSER-013, #AST-US-001, #AST-US-002, #AST-US-003)
        POSTCONDITION: "The design uses the existing file export format for stdout and defines exclusive AST routing and stderr diagnostics"
        POSTCONDITION: "Validated semantic exports reconcile occurrences by default and report the exact-byte digest after delivery"
    11. ACHIEVE "Update Design/contract_modeling_design.gasd for GEP-7" @trace #GEP-7
        POSTCONDITION: "The design specifies typed signatures, case rules and LINT-007, guard order and AST export, observed call verification, and bundled example compatibility. Every GEP-7 test ID is traced."
    12. ENSURE "All generated design gasd pass 'gasd_parser --ast-sem' with no errors"
        OTHERWISE THROW "Design Syntax or Semantic Error Detected"
    13. ENSURE "All steps 1-12 are completed correctly, faithfully, and thoroughly"
        OTHERWISE THROW "Design Quality Gate Failed: Incomplete or Unfaithful Execution"

// ===================================================================
// PHASE 2 — Generate Validations (Output: Validation/ folder)
// Generate explicit, comprehensive GASD validations for Design, Acceptance, Regression, and Negative cases.
// ===================================================================

FLOW phase2_generate_validations():
    1. ACHIEVE "Read and master Requirements/ver-2.x/, Requirements/ver-2.x/ver-2.1/semantic_pass.md, Requirements/ver-2.x/ver-2.1/gasd_file_version.md, Requirements/ver-2.x/ver-2.1/relative_source_map_paths.md, Requirements/ver-2.x/ver-2.1/cli_default_info_output.md, Requirements/ver-2.x/ver-2.1/enforce_invariant_order.md, Requirements/ver-2.x/ver-2.1/ast_output_exclusive_file.md and Design/ folders to ensure expertise before generation":
        POSTCONDITION: "Expertise attained from source documents"
    2. ENSURE "All validation gasd are generated ONLY from Requirements/ and Design/"
        OTHERWISE THROW "Validation Source Violation: Implementation Leakage"
    3. ACHIEVE "Exhaustive validation of Design of all cases based on Design gasd; output to Validation/Design/"
        POSTCONDITION: "Validation/Design/ updated"
    4. ACHIEVE "Exhaustive validation of Acceptance Tests of all cases; output to Validation/Acceptance/"
        POSTCONDITION: "Validation/Acceptance/ updated"
    5. ACHIEVE "Validation of Regression Tests of all cases; output to Validation/Regression/"
        POSTCONDITION: "Validation/Regression/ updated"
    6. ACHIEVE "Exhaustive validation of Negative Tests of all cases; output to Validation/Negative/"
        POSTCONDITION: "Validation/Negative/ updated"
    7. ACHIEVE "Exhaustive validation of Annotation Semantic Registry (all 21 triples); output to Validation/SemanticRegistry/" @trace #US-V2-002
        POSTCONDITION: "Validation/SemanticRegistry/ updated"
    8. ACHIEVE "Exhaustive validation of GEP-6 Linting Engine (Rules LINT-001 to LINT-012); output to Validation/Linting/" @trace #US-V2-001
        POSTCONDITION: "Validation/Linting/ updated"
    9. ACHIEVE "Exhaustive validation of Command-Line Versioning and LINT-013; output to Validation/CLI/" @trace #US-V2-009
        POSTCONDITION: "Validation/CLI/ updated"
    10. ACHIEVE "Exhaustive validation of Semantic Validation Marker (US-PARSER-008); output to Validation/Design/semantic_validation_marker_tests.gasd, Validation/Acceptance/semantic_validation_marker_acceptance.gasd, Validation/Regression/semantic_validation_marker_regression.gasd, and Validation/Negative/semantic_validation_marker_negative.gasd" @trace #US-PARSER-008
        POSTCONDITION: "Validation/Design/, Validation/Acceptance/, Validation/Regression/, and Validation/Negative/ updated"
    11. ACHIEVE "Exhaustive validation of GASD File Version Integration (US-PARSER-009); output to Validation/Design/gasd_file_version_tests.gasd, Validation/Acceptance/gasd_file_version_acceptance.gasd, Validation/Regression/gasd_file_version_regression.gasd, and Validation/Negative/gasd_file_version_negative.gasd" @trace #US-PARSER-009
        POSTCONDITION: "Validation/Design/, Validation/Acceptance/, Validation/Regression/, and Validation/Negative/ updated for US-PARSER-009"
    12. ACHIEVE "Exhaustive validation of Universal Relative JSON Paths (US-PARSER-010); output to Validation/Design/relative_json_paths_tests.gasd, Validation/Acceptance/relative_json_paths_acceptance.gasd, Validation/Regression/relative_json_paths_regression.gasd, and Validation/Negative/relative_json_paths_negative.gasd" @trace #US-PARSER-010
        POSTCONDITION: "Validation/Design/, Validation/Acceptance/, Validation/Regression/, and Validation/Negative/ updated for US-PARSER-010"
    13. ACHIEVE "Exhaustive validation of CLI Default Info Output (US-PARSER-011); output to Validation/Design/cli_default_info_output_tests.gasd, Validation/Acceptance/cli_default_info_output_acceptance.gasd, Validation/Regression/cli_default_info_output_regression.gasd, and Validation/Negative/cli_default_info_output_negative.gasd" @trace #US-PARSER-011
        POSTCONDITION: "Validation/Design/, Validation/Acceptance/, Validation/Regression/, and Validation/Negative/ updated for US-PARSER-011"
    ### Validation: Enforce INVARIANT Scope Ordering (US-PARSER-012)
    14. ACHIEVE "Exhaustive validation of Invariant Scope Ordering (US-PARSER-012); output to Validation/Design/enforce_invariant_order_tests.gasd, Validation/Acceptance/enforce_invariant_order_acceptance.gasd, Validation/Regression/enforce_invariant_order_regression.gasd, and Validation/Negative/enforce_invariant_order_negative.gasd" @trace #US-PARSER-012
        POSTCONDITION: "Validation/Design/, Validation/Acceptance/, Validation/Regression/, and Validation/Negative/ updated for US-PARSER-012"
    ### Validation: AST JSON destination parity (US-PARSER-013)
    15. ACHIEVE "Update the AST output design, acceptance, regression, and negative validation scenarios under Validation/" @trace #US-PARSER-013
        POSTCONDITION: "Scenarios cover the complete JSON document, encoding, exclusive routing, combined and syntax-only export, stdin, diagnostics, and output failures"
        POSTCONDITION: "The CPC scenarios cover transitive source capture, export reconciliation, inventory mappings, and the exact-byte digest"
    16. ACHIEVE "Generate GEP-7 contract validation scenarios in Validation/Design, Validation/Acceptance, Validation/Regression, and Validation/Negative" @trace #GEP-7
        POSTCONDITION: "The scenarios cover typed signatures, both AST export modes, guard eligibility, all verification statuses, inventory behavior, and invalid contract structure, binding, and timing."
    17. ENSURE "Each folder (Validation/Design, Validation/Acceptance, Validation/Regression, Validation/Negative, Validation/SemanticRegistry, Validation/Linting, Validation/CLI) or file (Validation/Design/semantic_validation_marker_tests.gasd, Validation/Design/gasd_file_version_tests.gasd, Validation/Design/relative_json_paths_tests.gasd, Validation/Design/cli_default_info_output_tests.gasd, Validation/Design/enforce_invariant_order_tests.gasd, Validation/Design/ast_output_exclusive_file_tests.gasd) passes 'gasd_parser --ast-sem' with no errors"
        OTHERWISE THROW "Validation Syntax or Semantic Error Detected"
    18. ENSURE "All steps 1-17 are completed correctly, faithfully, and thoroughly"
        OTHERWISE THROW "Validation Quality Gate Failed: Incomplete or Unfaithful Execution"

// ===================================================================
// PHASE 3 — Testing (Output: Impl/tests/ folder)
// Generate all acceptance and regression tests, then run to pass.
// ===================================================================

FLOW phase3_generate_tests():
    /// Requirement: Consult ONLY Requirements/ and Design/ folders.
    /// Do NOT use Impl/ (implementation) as a reference during test generation.
    1. ACHIEVE "Review Requirements/, Validation/ and Design/ for testing scope"
        POSTCONDITION: "Scope of tests defined"
    2. ENSURE "No Impl/ (implementation) code is used as reference"
        OTHERWISE THROW "Design Violation: Implementation Leakage"

    // --- Backward Compatibility Gate (MUST run first) ---
    3. ENSURE "All existing tests pass unmodified before any new test generation"
        OTHERWISE THROW "Regression Detected: Existing Tests Failed"

    // --- Acceptance Tests ---
    4. ACHIEVE "Generate most comprehensive Impl/tests/acceptance/test_component.py from Validation/Acceptance/ including all scenarios and cases" @trace #AT-001-01, #US-PARSER-007
        POSTCONDITION: "Acceptance tests generated"
    5. ENSURE "All AC and AT from Validation/Acceptance/ are covered by acceptance tests"
        OTHERWISE THROW "Testing Coverage Gap Detected: Acceptance"

    // --- Regression Tests ---
    6. ACHIEVE "Generate most comprehensive Impl/tests/regression/test_component.py from Validation/Regression/ including all scenarios and cases" @trace #RT-001-01, #US-PARSER-007
        POSTCONDITION: "Regression tests generated"
    7. ENSURE "All RT from Validation/Regression/ are covered by regression tests"
        OTHERWISE THROW "Testing Coverage Gap Detected: Regression"

    // --- Negative Tests ---
    8. ACHIEVE "Add most comprehensive negative testing suite from Validation/Negative/ covering all spec constraints, scenarios, and cases"
        POSTCONDITION: "Negative tests generated"
    9. ENSURE "Negative tests from Validation/Negative/ correctly trigger and validate expected failures"
        OTHERWISE THROW "Negative Testing Failure"

    // --- Design Validation Tests ---
    10. ACHIEVE "Generate most comprehensive Impl/tests/design_validation/component_tests.py from Validation/Design/ including all scenarios and cases"
        POSTCONDITION: "Design validation tests generated"
    11. ENSURE "Design validation tests match the specifications in Validation/Design/"
        OTHERWISE THROW "Design Validation Mismatch"

    // --- Annotation Semantic Registry ---
    12. ACHIEVE "Generate exhaustive unit and integration tests for Annotation Semantic Registry from Validation/SemanticRegistry/" @trace #US-V2-002
        POSTCONDITION: "Semantic Registry tests generated"
    13. ENSURE "Registry tests verify all 21 standard annotation triples"
        OTHERWISE THROW "Semantic Registry Coverage Failure"

    // --- GEP-6 Linting Engine ---
    14. ACHIEVE "Generate exhaustive unit and integration tests for GEP-6 Linting Engine from Validation/Linting/" @trace #US-V2-001
        POSTCONDITION: "Linting Engine tests generated"
    15. ENSURE "Linting tests verify all 12 rules with version-sensitive severity"
        OTHERWISE THROW "Linting Engine Coverage Failure"

    // --- Command-Line Versioning & Flag Consolidation ---
    16. ACHIEVE "Generate exhaustive acceptance tests for Command-Line Versioning, Flag Consolidation (removing --ast), and LINT-013 from Validation/CLI/" @trace #US-V2-009, #US-PARSER-007
        POSTCONDITION: "CLI tests generated"
    17. ENSURE "CLI tests verify --gasd-ver flag, LINT-013 (version mismatch), --ast removal (unknown argument), --ast-sem default mode, and --no-validate behavior"
        OTHERWISE THROW "CLI Acceptance Criteria Violation"
    18. ACHIEVE "Generate exhaustive acceptance tests for Semantic Validation Marker (US-PARSER-008) from Validation/ folders; output to Impl/tests/acceptance/test_semantic_validation_marker.py" @trace #US-PARSER-008
        POSTCONDITION: "Acceptance tests for US-PARSER-008 generated"
    19. ACHIEVE "Generate exhaustive tests for GASD File Version Integration (US-PARSER-009) from Validation/ folders; output to Impl/tests/acceptance/test_gasd_file_version.py, Impl/tests/regression/test_gasd_file_version_regression.py, Impl/tests/negative/test_gasd_file_version_negative.py" @trace #US-PARSER-009
        POSTCONDITION: "Acceptance tests for US-PARSER-009 generated"
    20. ACHIEVE "Generate exhaustive tests for Universal Relative JSON Paths (US-PARSER-010) from Validation/ folders; output to Impl/tests/acceptance/test_relative_json_paths.py, Impl/tests/regression/test_relative_json_paths_regression.py, Impl/tests/negative/test_relative_json_paths_negative.py" @trace #US-PARSER-010
        POSTCONDITION: "Acceptance tests for US-PARSER-010 generated"
    21. ACHIEVE "Generate exhaustive tests for CLI Default Info Output (US-PARSER-011) from Validation/ folders; output to Impl/tests/acceptance/test_cli_default_info_output.py, Impl/tests/regression/test_cli_default_info_output_regression.py, Impl/tests/negative/test_cli_default_info_output_negative.py" @trace #US-PARSER-011
        POSTCONDITION: "Acceptance tests for US-PARSER-011 generated"
    ### Testing: Enforce INVARIANT Scope Ordering (US-PARSER-012)
    22. ACHIEVE "Generate exhaustive tests for Invariant Scope Ordering (US-PARSER-012) from Validation/ folders; output to Impl/tests/acceptance/test_enforce_invariant_order.py, Impl/tests/regression/test_enforce_invariant_order_regression.py, Impl/tests/negative/test_enforce_invariant_order_negative.py" @trace #US-PARSER-012
        POSTCONDITION: "Acceptance tests for US-PARSER-012 generated"
    ### Testing: AST JSON destination parity (US-PARSER-013)
    23. ACHIEVE "Update acceptance, regression, and negative AST output tests from the validation scenarios" @trace #US-PARSER-013
        POSTCONDITION: "CLI tests compare the full exports, verify byte equality with fixed run metadata, and assert that diagnostics remain accessible on stderr"
        POSTCONDITION: "Impl/tests/acceptance/test_cpc_semantic_ast.py verifies source reconciliation through the ordinary export flags"
    24. ACHIEVE "Generate executable tests from the GEP-7 validation scenarios in Impl/tests" @trace #GEP-7
        POSTCONDITION: "All GEP-7 IDs map to tests. Feature tests are run against the unchanged baseline to record the gaps that Phase 4 must close."
    25. ENSURE "All acceptance tests (Steps 4-24) accurately reflect the logic defined in the Validation/ folders"
        OTHERWISE THROW "Testing Quality Gate Failed: Mismatch with Validation Specifications"
    26. ENSURE "All Steps 1-25 are completed correctly, faithfully, and thoroughly"
        OTHERWISE THROW "Phase 3 Quality Gate Failed: Incomplete or Unfaithful Execution"

// ===================================================================
// PHASE 4 — Implementation (Output: Impl/ folder)
// Generate production code from Phase 1 designs.
// ===================================================================

FLOW phase4_generate_implementation():
    /// Requirement: Consult ONLY the Design/ and Validation/ folders.
    /// Do NOT use the Requirements/ folder as a reference during implementation.
    // --- Core Implementation Milestones ---
    1. ACHIEVE "Update Impl/parser/ to support VERSION 1.2 and new syntax invariants"
        POSTCONDITION: "Parser supports 1.2 syntax"
    2. ACHIEVE "Implement Impl/semantic/AnnotationRegistry.py with 21 standard triples" @trace #US-V2-002
        POSTCONDITION: "AnnotationRegistry.py implemented"
    3. ACHIEVE "Implement Impl/semantic/LintEngine.py with 13 validation rules (LINT-001 to LINT-013)" @trace #US-V2-001, #US-V2-009
        POSTCONDITION: "LintEngine.py implemented"
    4. ACHIEVE "Enhance Impl/semantic/ to support CONTRACT, CASE and POSTCONDITION enforcement"
        POSTCONDITION: "Semantic support for 1.2 constructs added"
    5. ACHIEVE "Implement ENVIRONMENTAL vs ASSUMPTION validation logic"
        POSTCONDITION: "Assumption validation logic implemented"

    // --- CLI Flag Consolidation (US-PARSER-007) ---
    6. ACHIEVE "Implement version-sensitive CLI flag logic: --gasd-ver {1.1 | 1.2}, --ast-combine, and LINT-013 validation" @trace #US-V2-009, #US-PARSER-007
        POSTCONDITION: "CLI versioning and batch logic updated"
    7. ACHIEVE "Enable semantic validation by default and use --no-validate for syntax-only output" @trace #AC-PARSER-007-02, #AC-PARSER-007-03, #AC-PARSER-007-04
        POSTCONDITION: "AST-SEM and validation flags implemented"
    8. ACHIEVE "Remove --ast flag and ensure it is treated as an unknown option; ensure no-flag execution defaults to --ast-sem with validation" @trace #AC-PARSER-007-01, #AC-PARSER-007-02
        POSTCONDITION: "--ast flag removed"
    9. ACHIEVE "Implement 'semantic_validate' marker injection in Impl/cli.py and Impl/semantic/SemanticASTExporter.py" @trace #US-PARSER-008
        POSTCONDITION: "JSON output includes validation certificate with status and metadata"
    10. ACHIEVE "Implement 'gasd_file_version' injection into the semantic_validate marker and 'version' injection into semantic metadata in Impl/semantic/SemanticASTExporter.py" @trace #US-PARSER-009
        POSTCONDITION: "JSON output contains explicit file version or 'unknown' in both semantic_validate.gasd_file_version and metadata.version"
    11. ACHIEVE "Implement Universal Relative JSON Paths ('Zero-Leak' relativization) in JSON serialization in Impl/semantic/SemanticASTExporter.py and associated formatters" @trace #US-PARSER-010
        POSTCONDITION: "All absolute paths in generated JSON are relativized to the CWD"
    12. ACHIEVE "Implement CLI default info output to display version and build info when no arguments are provided in Impl/cli.py" @trace #US-PARSER-011
        POSTCONDITION: "gasd_parser displays version and build info along with help text when no arguments are passed"
    ### Implementation: Enforce INVARIANT Scope Ordering (US-PARSER-012)
    13. ACHIEVE "Update GASDParser.g4 grammar to enforce INVARIANT <SCOPE> ordering and reject reversed order" @trace #US-PARSER-012
        POSTCONDITION: "Grammar restricts invariant scope placement"
    ### Implementation: AST JSON destination parity (US-PARSER-013)
    14. ACHIEVE "Route the existing AST serialization to stdout or --ast-output with the JSON report on stderr" @trace #US-PARSER-013
        POSTCONDITION: "An explicit path receives the same UTF-8 AST bytes that stdout would receive and leaves stdout empty"
        POSTCONDITION: "Validated semantic exports capture sources and reconcile the occurrence inventory before either destination receives the AST"
    
    15. ACHIEVE "Implement GEP-7 from the contract design and validations" @trace #GEP-7
        POSTCONDITION: "The grammar and generated parser retain ordered guards, both AST exports preserve them, the validator enforces contract rules, and the verifier evaluates observed calls. Bundled examples satisfy the same static rules."
    16. ENSURE "No information from the Requirements/ folder is used for implementation"
        OTHERWISE THROW "Design Violation: Implementation Leakage"
    17. ENSURE "Implementation compiles successfully and passes all unit tests generated in Phase 3"
        OTHERWISE THROW "Build Failed: Compilation or Test Error"
    18. ENSURE "All steps 1-17 are completed correctly, faithfully, and thoroughly"
        OTHERWISE THROW "Implementation Quality Gate Failed: Incomplete or Unfaithful Execution"

// ===================================================================
// PHASE 5 — Full Quality Gate
// All tests must pass before delivery.
// ===================================================================

FLOW phase5_full_quality_gate():
    1. ACHIEVE "Execute full test suite via: python3 -m pytest -p no:asyncio -q"
        POSTCONDITION: "Full test suite executed; baseline failures and errors identified"
    2. ACHIEVE "Fix --ast-combine semantics: ensure --ast-combine produces a single unified SemanticSystem (not per-file split)"
        POSTCONDITION: "The CLI tests verify one top-level SemanticSystem containing the compilation units for all combined inputs"
    3. ACHIEVE "Fix CLI import portability: convert all 'from Impl.xxx' absolute imports to relative imports in cli.py"
        POSTCONDITION: "CLI works in both development mode (python -m Impl.cli) and packaged mode (python -m gasd_parser)"
    4. ACHIEVE "Fix LINT-013 version mismatch severity: version mismatch between CLI --gasd-ver and file VERSION directive is always ERROR regardless of direction"
        POSTCONDITION: "LINT-013 consistently reports ERROR"
    5. ACHIEVE "Verify US-PARSER-008 (Semantic Validation Marker) acceptance criteria are fully met by the test suite" @trace #US-PARSER-008
        POSTCONDITION: "test_semantic_validation_marker.py passes 100%"
        POSTCONDITION: "LINT-013 emits ERROR in both VersionResolver and LintEngine; both 1.1→1.2 and 1.2→1.1 mismatches produce exit code 1"
    6. ACHIEVE "Verify US-PARSER-009 (GASD File Version) acceptance criteria are fully met by the test suite" @trace #US-PARSER-009
        POSTCONDITION: "test_gasd_file_version.py passes 100%"
    7. ACHIEVE "Verify US-PARSER-010 (Relative JSON Paths) acceptance criteria are fully met by the test suite" @trace #US-PARSER-010
        POSTCONDITION: "test_relative_json_paths.py passes 100%"
    8. ACHIEVE "Verify US-PARSER-011 (CLI Default Info Output) acceptance criteria are fully met by the test suite" @trace #US-PARSER-011
        POSTCONDITION: "test_cli_default_info_output.py passes 100%"
    ### Quality Gate: Enforce INVARIANT Scope Ordering (US-PARSER-012)
    9. ACHIEVE "Verify US-PARSER-012 (Invariant Scope Ordering) acceptance criteria are fully met by the test suite" @trace #US-PARSER-012
        POSTCONDITION: "test_enforce_invariant_order.py passes 100%"
    ### Quality Gate: AST JSON destination parity (US-PARSER-013)
    10. ACHIEVE "Run the AST output acceptance, regression, and negative tests and compare actual stdout and file exports" @trace #US-PARSER-013
        POSTCONDITION: "Both destinations produce the file export schema, and comparison accounts only for generated node IDs and validation timestamps between independent runs"
    11. ACHIEVE "Align contradictory test expectations across acceptance, regression, and packaging test suites"
        POSTCONDITION: "No conflicting assertions across test suites for --ast-combine semantics or LINT-013 severity"
    12. ACHIEVE "Eliminate duplicate LINT-013 diagnostic emission between VersionResolver and LintEngine"
        POSTCONDITION: "Each version mismatch produces exactly one ERROR diagnostic per file"
    13. ENSURE "All tests pass with 0 failures and 0 errors via: python3 -m pytest -p no:asyncio -q"
        OTHERWISE THROW "Build Failure: Quality Gate Failed"
    14. ACHIEVE "Pass full suite validation on GASD 1.1 examples via: python3 -m Impl.cli Specs/examples/gasd-1.1 --gasd-ver 1.1"
        POSTCONDITION: "GASD 1.1 examples validated"
    15. ACHIEVE "Pass full suite validation on GASD 1.2 examples via: python3 -m Impl.cli Specs/examples/gasd-1.2 --gasd-ver 1.2" @trace #RT-GEP7-001
        POSTCONDITION: "GASD 1.2 examples validated"
        POSTCONDITION: "All bundled GASD 1.2 examples pass individually and as a suite with zero warnings"
    16. ENSURE "All acceptance, regression, negative, design validation, and semantic tests pass, including the CPC export and GEP-7 checks"
        OTHERWISE THROW "Build Failure: Quality Gate Failed"

// ===================================================================
// PHASE 6 — Final Packaging (Output: Build/Installation/dist/ folder)
// Unified packaging of components into a standalone application.
// ===================================================================

FLOW phase6_final_packaging():
    1. ACHIEVE "Bump the project version in Impl/__init__.py and pass the full quality gate before packaging"
        POSTCONDITION: "The CLI, package metadata, and installation documentation agree on the release version"
    2. ACHIEVE "Inject current ISO-8601 timestamp into Impl/__init__.py during build"
        POSTCONDITION: "__build_time__ reflects actual execution time"
    3. ACHIEVE "Synchronize and clean up all project artifacts and documentation"
        POSTCONDITION: "The README, installation guide, and release notes show the current version and default semantic export commands"
    4. ACHIEVE "Assemble production artifacts into Build/Installation/dist/ directory"
        POSTCONDITION: "package.sh builds the wheel and source distribution for the release version"
    5. ENSURE "No operations modify, pollute, or delete the parent 'Build/' folder — all artifacts must strictly go to 'Build/Installation/dist/'"
        OTHERWISE THROW "Packaging Failed: Build Directory Mutation"
    6. ACHIEVE "Verify clean installation of the packaged wheel"
        POSTCONDITION: "Installing the release wheel from Build/Installation/dist in a temporary environment succeeds"
    7. ENSURE "The installed CLI reports its version and build time, passes stdout and file AST parity, verifies source occurrences by default, publishes the exact-byte digest, and exposes the GEP-7 verifier" @trace(#US-PARSER-013, #AST-AC-003-01, #AST-AC-003-02)
        OTHERWISE THROW "Packaging Failed: Functionality Sanity Error"
